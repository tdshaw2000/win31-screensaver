#include <windows.h>
#include "resource.h"

STRINGTABLE
BEGIN
    NAME,        "Win31SS"
    DESCRIPTION, "Win31SS - a placeholder Windows 3.1 screensaver"
END

IDD_CONFIG DIALOG 20, 20, 160, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Win31SS Settings"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT         "Ball color:", -1, 10, 16, 40, 8
    COMBOBOX      IDC_COLOR, 55, 14, 95, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",     IDOK,     55, 45, 40, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 100, 45, 40, 14
END
