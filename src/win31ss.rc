#include <windows.h>
#include "resource.h"

STRINGTABLE
BEGIN
    NAME,        "Win31SS"
    DESCRIPTION, "Win31SS - a placeholder Windows 3.1 screensaver"
END

IDD_CONFIG DIALOG 20, 20, 160, 121
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Win31SS Settings"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT         "Colour:", -1, 10, 16, 40, 8
    COMBOBOX      IDC_COLOR, 55, 14, 95, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT         "Size:", -1, 10, 35, 40, 8
    SCROLLBAR     IDC_BALLSIZE, 55, 33, 70, 10, SBS_HORZ | WS_TABSTOP
    LTEXT         "40", IDC_BALLSIZE_VALUE, 129, 35, 22, 8
    LTEXT         "Sides:", -1, 10, 54, 40, 8
    SCROLLBAR     IDC_SIDES, 55, 52, 70, 10, SBS_HORZ | WS_TABSTOP
    LTEXT         "1: Circle", IDC_SIDES_VALUE, 10, 65, 140, 8
    LTEXT         "Speed:", -1, 10, 84, 40, 8
    SCROLLBAR     IDC_SPEED, 55, 82, 70, 10, SBS_HORZ | WS_TABSTOP
    LTEXT         "2", IDC_SPEED_VALUE, 129, 84, 22, 8
    DEFPUSHBUTTON "OK",     IDOK,     55, 99, 40, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 100, 99, 40, 14
END
